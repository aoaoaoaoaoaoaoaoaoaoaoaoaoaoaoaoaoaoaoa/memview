<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>memview third-party licenses</title>
  <style>
    body { font: 16px/1.45 sans-serif; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #aaa; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>memview third-party licenses</h1>
  <p>Generated from the locked Cargo dependency graph by cargo-about.</p>
  {{#each licenses}}
  <section>
    <h2 id="{{id}}-{{@index}}">{{name}}</h2>
    <p>Used by:
      {{#each used_by}}
      <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
      {{/each}}
    </p>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
